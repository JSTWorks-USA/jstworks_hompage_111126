# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 인증서 원본(고해상도)은 저장소에 올리지 않습니다. 사이트에는 public/의 저해상도본만 씁니다.
/assets/originals/

# bkit 플러그인의 로컬 감사 로그·실행 상태
/.bkit/

# Better Design MCP configs (contain API key)
.mcp.json
