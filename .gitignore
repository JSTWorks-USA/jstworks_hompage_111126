# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 값 없이 변수 이름만 적은 안내 파일은 올립니다
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 인증서 원본(고해상도)은 저장소에 올리지 않습니다. 사이트에는 public/의 저해상도본만 씁니다.
/assets/originals/

# After Effects 빌드 산출물: 스크립트·로그·렌더 원본은 다시 만들 수 있어 올리지 않습니다(.aep 는 올립니다).
/assets/motion/*.jsx
/assets/motion/*.log.txt
/assets/motion/ae-error.txt
/assets/motion/*-master.*
/assets/motion/*로그/

# bkit 플러그인의 로컬 감사 로그·실행 상태
/.bkit/

# Better Design MCP configs (contain API key)
.mcp.json
.cursor/mcp.json
.vscode/mcp.json
opencode.json
